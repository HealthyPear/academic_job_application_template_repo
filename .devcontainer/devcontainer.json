{
    "name": "job_application",
    "image": "condaforge/miniforge3:latest",
    "postCreateCommand": "mamba env create -y -f envs/devcontainer.yaml || mamba env update -y -n dev -f envs/devcontainer.yaml",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "snakemake.snakemake-lang",
                "redhat.vscode-yaml",
                "wytheglobal.pdfmore",
                "tfehlmann.snakefmt",
                "gruntfuggly.triggertaskonsave"
            ],
            "settings": {
                "editor.formatOnSave": true,
                "snakefmt.showNotifications": "always",
                "python.defaultInterpreterPath": "/opt/conda/envs/dev/bin/python"
            }
        }
    },
    "features": {
        "ghcr.io/devcontainers/features/git:1": {}
    }
}